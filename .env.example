# ===============================================================
# ENQUIRY EMAIL DELIVERY
# ===============================================================
# Every contact and quote submission is emailed to the address in
# ENQUIRY_TO_EMAIL below. Without RESEND_API_KEY nothing is sent —
# the enquiry is only written to the server log, and the visitor is
# shown your phone and email as a fallback.
#
# SETUP (about five minutes, free):
#
#  1. Sign up at https://resend.com using apexwebsolutionsuk@gmail.com
#     — use that exact address, it matters for step 3.
#  2. Go to "API Keys", create one, and paste it below.
#  3. Leave ENQUIRY_FROM_EMAIL as the resend.dev default to start.
#     Resend allows that sender to deliver ONLY to the address that
#     owns the account — which is why step 1 uses your Gmail.
#  4. Later, verify apexwebsolutionsuk.com in Resend under "Domains"
#     and switch the from-address to enquiries@apexwebsolutionsuk.com.
#     That looks more professional and lands in the inbox more often.
#
# Then copy this file to .env.local and restart the dev server:
#     cp .env.example .env.local
#
# Check it worked by visiting /api/contact — it should report
# "emailDeliveryConfigured": true
# ---------------------------------------------------------------

RESEND_API_KEY=

# Where enquiries are delivered. Comma-separate for more than one.
ENQUIRY_TO_EMAIL=apexwebsolutionsuk@gmail.com

# The sender. Keep the resend.dev default until you've verified your
# own domain in Resend, otherwise sending will fail.
ENQUIRY_FROM_EMAIL="Apex Website <onboarding@resend.dev>"
