# ===============================================================
# ENQUIRY EMAIL DELIVERY
# ===============================================================
# You do NOT need this file to receive enquiries.
#
# Out of the box, submissions are forwarded to ENQUIRY_TO_EMAIL by
# FormSubmit (https://formsubmit.co) — free, no account required.
# The first enquiry to a new address triggers a one-time "Activate
# Form" email; click the link once and forwarding stays on.
#
# Set RESEND_API_KEY below only when you want to send from your own
# verified domain instead. The endpoint switches over automatically.
#
#  1. Sign up at https://resend.com
#  2. Verify apexwebsolutionsuk.com under "Domains"
#  3. Create an API key and paste it below
#  4. Set ENQUIRY_FROM_EMAIL to an address on that domain
#
#     cp .env.example .env.local
#
# Confirm which transport is live by visiting /api/contact
# ---------------------------------------------------------------

RESEND_API_KEY=

# Where enquiries are delivered. Comma-separate for more than one.
ENQUIRY_TO_EMAIL=apexwebsolutionsuk@gmail.com

# Only used when RESEND_API_KEY is set. Must be on a domain you have
# verified in Resend, or sending will fail.
ENQUIRY_FROM_EMAIL="Apex Website <enquiries@apexwebsolutionsuk.com>"
