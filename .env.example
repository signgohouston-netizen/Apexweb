# ---------------------------------------------------------------
# Enquiry form email delivery (optional but recommended)
# ---------------------------------------------------------------
# Without RESEND_API_KEY the contact/quote form still works: the
# submission is logged on the server and the visitor is shown your
# phone and email as a fallback. Set the key to receive emails.
#
# 1. Sign up at https://resend.com (free tier is plenty)
# 2. Verify your sending domain
# 3. Paste the API key below

RESEND_API_KEY=

# Where enquiries are delivered. Defaults to the address in
# src/content/site.ts if left blank.
ENQUIRY_TO_EMAIL=apexwebsolutionsuk@gmail.com

# The "from" address. Must be on a domain you've verified in Resend.
ENQUIRY_FROM_EMAIL="Apex Website <enquiries@apexwebsolutionsuk.com>"
