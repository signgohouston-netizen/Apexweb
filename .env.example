# ===============================================================
# ENQUIRY EMAIL DELIVERY
# ===============================================================
# Enquiries work with NO configuration: they are forwarded to
# ENQUIRY_TO_EMAIL by FormSubmit (free, no account). Note that
# FormSubmit activates per DOMAIN — the first enquiry from each
# domain triggers an "Activate Form" email you must click once.
#
# Set RESEND_API_KEY to send through Resend instead. If Resend is
# configured but fails, delivery falls back to FormSubmit so a
# lead is never lost.
#
#   cp .env.example .env.local
#
# Check what is actually live by visiting /api/contact — it
# validates the key and lists your verified sending domains.
# ---------------------------------------------------------------

# Leave blank to use FormSubmit. Paste a key from resend.com to
# switch to Resend.
RESEND_API_KEY=

# Where enquiries are delivered. Comma-separate for more than one.
# IMPORTANT: never save this with an empty value.
ENQUIRY_TO_EMAIL=apexwebsolutionsuk@gmail.com

# Only used with Resend. Leave BLANK until you have verified your
# domain in Resend — the default shared sender needs no DNS setup,
# but only delivers to the address that owns the Resend account.
# Once apexwebsolutionsuk.com is verified, set:
#   ENQUIRY_FROM_EMAIL="Apex Website <enquiries@apexwebsolutionsuk.com>"
ENQUIRY_FROM_EMAIL=
